# ─────────────────────────────────────────────────────────────────
#  MAILCLAW — Environment Variables
#  Copy to .env for local dev, or paste into Railway dashboard
# ─────────────────────────────────────────────────────────────────

# ── Telegram ──────────────────────────────────────────────────────
TELEGRAM_TOKEN=7891234567:AAHxyz...
# Comma-separated Telegram user IDs (get yours from @userinfobot)
TELEGRAM_ALLOWED_USERS=123456789,987654321

# ── Instantly (one per client) ────────────────────────────────────
INSTANTLY_CLIENT_4DD=your_instantly_api_key
# INSTANTLY_CLIENT_GD=another_key

# ── Reoon Email Verification ──────────────────────────────────────
REOON_KEY=your_reoon_api_key
# Multiple accounts:
# REOON_KEY_1=key_one
# REOON_KEY_1_NAME=account1
# REOON_KEY_2=key_two
# REOON_KEY_2_NAME=account2

# ── AI Providers (only configure what you use) ────────────────────
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...
OPENAI_API_KEY=sk-...

# ── Analytics Profiles ────────────────────────────────────────────
# Get profile JSON: cat ~/.mailclaw/analytics/will.json | python3 -m json.tool --compact
ANALYTICS_PROFILE_WILL={"name":"will","client_name":"4dd","benchmarks":{"bounce_rate":0.05,"unsubscribe_rate":0.02,"reply_rate":0.05,"human_reply_rate":0.01,"positive_reply_rate":0.20,"meeting_book_rate":0.25,"meeting_attend_rate":0.80},"manual_fields":{"follow_ups":null,"sales_usd":null},"campaign_name_filter":""}

# ── Set automatically by Railway — do not set manually ────────────
# PORT=8080
