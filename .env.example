# ─────────────────────────────────────────────────────────────────
#  MAILCLAW — Environment variables
#  Local: copy to .env  |  Railway: Variables tab
#
#  On Railway, RAILWAY_ENVIRONMENT is set → env-only config (no ~/.mailclaw JSON).
#  Optional: MAILCLAW_LOG_STDERR=1 → INFO logs to Railway deploy log (default on Railway).
#  MAILCLAW_CONFIG_SOURCE=file → force JSON config (e.g. mounted volume)
# ─────────────────────────────────────────────────────────────────

# ── Telegram ──────────────────────────────────────────────────────
TELEGRAM_TOKEN=7891234567:AAHxyz...
TELEGRAM_ALLOWED_USERS=123456789,987654321

# ── Instantly — ONE API key per client (multi-tenant) ──────────────
INSTANTLY_CLIENT_WILL=your_instantly_api_key_workspace_will
INSTANTLY_CLIENT_GD=your_instantly_api_key_workspace_gd

# ── AI: global keys (fallback if a client has no PREFIX_* vars) ────
GEMINI_API_KEY=AIza_global
OPENAI_API_KEY=sk_global_optional
ANTHROPIC_API_KEY=sk-ant-optional

# ── AI: per-client keys (PREFIX = client name from INSTANTLY_CLIENT_<NAME>, UPPERCASE)
# Example: INSTANTLY_CLIENT_WILL → WILL_GEMINI_API_KEY, WILL_OPENAI_API_KEY_2, …
WILL_GEMINI_API_KEY=AIza_will_primary
WILL_GEMINI_API_KEY_2=AIza_will_backup
WILL_GEMINI_API_KEY_3=AIza_will_third
WILL_OPENAI_API_KEY=sk_will

GD_GEMINI_API_KEY=AIza_gd

# ── Reoon (shared pool; rotates) ──────────────────────────────────
REOON_KEY=your_reoon_api_key
# REOON_KEY_1=second_key
# REOON_KEY_1_NAME=backup

MAILCLAW_DAILY_LIMIT=2000
MAILCLAW_RATE_LIMIT_DELAY=0.12
MAILCLAW_REVERIFY_DAYS=7

# ── Analytics profile JSON (client_name must match INSTANTLY_CLIENT_* suffix) ─
# ANALYTICS_PROFILE_WILL={"name":"will","client_name":"will","benchmarks":{},"campaign_name_filter":""}

# ── Logging: show INFO in Railway deploy log (auto-enabled when RAILWAY_ENVIRONMENT is set)
# MAILCLAW_LOG_STDERR=1

# PORT is set by Railway — do not set manually unless local
