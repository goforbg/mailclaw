# ─────────────────────────────────────────────────────────────────
#  MAILCLAW — Environment Variables
#  Local: copy to .env  |  Railway: paste into Variables tab
#
#  Hosted (Railway, Docker): RAILWAY_ENVIRONMENT is set automatically →
#  config is env-only (no ~/.mailclaw JSON). Override with:
#    MAILCLAW_CONFIG_SOURCE=file   # use JSON + disk (e.g. mounted volume)
#    MAILCLAW_CONFIG_SOURCE=env    # force env-only even without Railway
# ─────────────────────────────────────────────────────────────────

# ── Telegram ──────────────────────────────────────────────────────
TELEGRAM_TOKEN=7891234567:AAHxyz...
# Comma-separated numeric user IDs (empty = anyone can use the bot)
TELEGRAM_ALLOWED_USERS=123456789,987654321

# ── Instantly — one API key per client (multi-tenant agencies) ─────
# Suffix after INSTANTLY_CLIENT_ becomes the internal client name (lowercased).
INSTANTLY_CLIENT_ACME=your_instantly_api_key
INSTANTLY_CLIENT_CONTOSO=another_instantly_api_key

# ── Reoon — multiple keys rotate automatically ──────────────────────
REOON_KEY=your_reoon_api_key
# Or numbered (names optional):
# REOON_KEY_1=key_one
# REOON_KEY_1_NAME=account_a
# REOON_KEY_2=key_two
# REOON_KEY_2_NAME=account_b

# Daily credits per key (used for rotation bookkeeping; live API is source of truth)
MAILCLAW_DAILY_LIMIT=2000

# ── AI providers — multiple keys per provider (failover / rotation) ─
# Primary + OPENAI_API_KEY_2, OPENAI_API_KEY_3, ...
OPENAI_API_KEY=sk-...
# OPENAI_API_KEY_2=sk-...
GEMINI_API_KEY=AIza...
# GEMINI_API_KEY_2=...
# Or use GOOGLE_API_KEY instead of GEMINI_API_KEY for Gemini
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_API_KEY_2=...

# ── Instantly API pacing (seconds between requests) ───────────────
MAILCLAW_RATE_LIMIT_DELAY=0.12
MAILCLAW_REVERIFY_DAYS=7

# ── Analytics profiles (JSON) — required for /analytics on Railway ─
# Name after ANALYTICS_PROFILE_ must match what you pass to /analytics <name>
# client_name must match an INSTANTLY_CLIENT_<name> suffix.
# ANALYTICS_PROFILE_WILL={"name":"will","client_name":"acme","benchmarks":{...},...}

# ── Set by platform — do not set manually unless debugging ────────
# PORT=8080
